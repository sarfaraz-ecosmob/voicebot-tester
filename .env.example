# Copy to .env to customize. Optional: `docker compose up -d --build` works
# with working defaults for everything except the OpenRouter key.

# --- PostgreSQL ---
POSTGRES_DB=voicebot
POSTGRES_USER=voicebot
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://voicebot:change-this-local-password@postgres:5432/voicebot

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- OpenRouter (AI test runs) -----------------------------------------------
# Get a key at https://openrouter.ai/keys and paste it after the `=`.
# Leave empty to keep the API in mock-only mode.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: attribution headers sent to OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Voicebot Testing

# --- Asterisk ----------------------------------------------------------------
# SDP address advertised for RTP media.
#   127.0.0.1 (default) -> browser softphone on this machine (Docker ports)
#   <host LAN IP>       -> softphones on other devices in your network
ASTERISK_EXTERNAL_MEDIA_ADDRESS=127.0.0.1

# ARI credentials used by the API's /api/asterisk/status proxy.
ASTERISK_ARI_USER=voicebot
ASTERISK_ARI_PASSWORD=change-this-ari-password
